{
  "name": "emanate-group-chat",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "start:fake": "MODEL_AGENT=fake:x MODEL_GATE=fake:x MODEL_CLASSIFIER=fake:x FAKE_SCRIPT=e2e node dist/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval": "tsx evals/run.ts",
    "spike": "tsx scripts/spike-ttft.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charliegillet/emanate-takehome.git"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@ai-sdk/openai": "^4.0.108",
    "@ai-sdk/openai-compatible": "^3.0.84",
    "@hono/node-server": "^2.1.6",
    "ai": "^7.0.162",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
