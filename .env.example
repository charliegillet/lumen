OPENAI_API_KEY=
# Only needed when a MODEL_* string uses that provider
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
MODEL_AGENT=openai:gpt-5.6-luna
MODEL_GATE=openai:gpt-5.6-luna
MODEL_CLASSIFIER=openai:gpt-5.6-luna
MODEL_JUDGE=openai:gpt-6-sol
# Per-agent overrides
# MODEL_AGENT_MAYA=
# MODEL_AGENT_THEO=
# MODEL_AGENT_PRIYA=
# OpenAI-compatible endpoint (optional)
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_STRUCTURED=1   send a JSON schema on structured calls (needed by most local servers)
# Limits and caps
# RATE_LIMIT_PER_MIN=20
# MAX_MESSAGES_PER_CONV=300
# GATE_TIMEOUT_MS=8000
# CLASSIFY_TIMEOUT_MS=6000
# STREAM_IDLE_MS=25000
DB_PATH=./data/chat.db
PORT=8080
